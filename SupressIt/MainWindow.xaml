<Window x:Class="SupressIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:SupressIt.Views.Panels"
        Title="SupressIt" Height="740" Width="1100"
        Background="Transparent" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        MinWidth="900" MinHeight="560">

    <!-- Outer rounded shell -->
    <Border x:Name="ShellBorder" CornerRadius="24" ClipToBounds="True"
          Background="{DynamicResource BgShell}">

        <Grid>
            <!-- Custom background image/gif layer -->
            <Grid x:Name="BgLayer" IsHitTestVisible="False" Panel.ZIndex="0"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <MediaElement x:Name="BgVideo" Stretch="UniformToFill"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Opacity="0.6" Visibility="Collapsed"/>
                <Image x:Name="BgImage" Stretch="UniformToFill"
                       Opacity="0.6" Visibility="Collapsed"/>
            </Grid>

            <!-- Flying anime kill animation overlay; KillAnimator adds short-lived media here dynamically -->
            <Canvas x:Name="OverlayCanvas" Panel.ZIndex="999" IsHitTestVisible="False"/>

            <!-- Main layout: content + anime side panel -->
            <Grid Panel.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: title + tabs + content + log ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>   <!-- title bar   -->
                        <RowDefinition Height="48"/>   <!-- tab bar     -->
                        <RowDefinition Height="*"/>    <!-- panel area  -->
                        <RowDefinition Height="130"/>  <!-- kill log    -->
                    </Grid.RowDefinitions>

                    <!-- ══ TITLE BAR ════════════════════════════════════ -->
                    <Border Grid.Row="0" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseDown" Padding="20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔨" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SupressIt" FontFamily="Segoe UI" FontWeight="Black"
                                               FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="cute app killer  ˙ᵕ˙" FontFamily="Segoe UI"
                                               FontSize="10" Foreground="{DynamicResource TextSoft}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- VPN badge -->
                            <Border Grid.Column="1" CornerRadius="12" Padding="12,5"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#20FF4060"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VpnActive}" Value="True">
                                                <Setter Property="Background" Value="#2040C060"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🔴"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VpnActive}" Value="True">
                                                        <Setter Property="Text" Value="🟢"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding VpnLabel}" FontFamily="Segoe UI"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C03050"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VpnActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#30A050"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Window buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="Minimize_Click" Width="28" Height="28"
                                        Margin="0,0,6,0" Cursor="Hand" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="{DynamicResource SoftBtnBg}" CornerRadius="14">
                                                <TextBlock Text="–" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentTabChecked}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Click="Close_Click" Width="28" Height="28"
                                        Cursor="Hand" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="#20FF4060" CornerRadius="14">
                                                <TextBlock Text="✕" Foreground="#C03050"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#35FF4060"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ TAB BAR ══════════════════════════════════════ -->
                    <Border Grid.Row="1" Background="{DynamicResource BgTabBar}" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="TabApps"      Content="🖥️ Apps"     IsChecked="True"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="Apps"/>
                                <ToggleButton x:Name="TabSystem"    Content="⚙️ System"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="System"/>
                                <ToggleButton x:Name="TabInternet"  Content="🌐 Internet"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="Internet"/>
                                <ToggleButton x:Name="TabStartup"   Content="🚀 Startup"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="Startup"/>
                                <ToggleButton x:Name="TabBlocked"   Content="🚫 Blocked"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="Blocked"/>
                                <ToggleButton x:Name="TabSettings"  Content="⚙ Settings"
                                              Style="{DynamicResource TabBtnStyle}" Click="Tab_Click" Tag="Settings"/>
                            </StackPanel>

                            <!-- Search + count -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource SoftBtnBg}" CornerRadius="14"
                                        Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 FontFamily="Segoe UI" FontSize="12" Width="110"
                                                 VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SoftBtnBg}" CornerRadius="12" Padding="10,5">
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ CONTENT AREA ══════════════════════════════════ -->
                    <Grid Grid.Row="2">
                        <!-- Each panel is a UserControl, visibility toggled by tab clicks -->
                        <panels:ProcessesPanel  x:Name="PanelApps"     DataContext="{Binding}"/>
                        <panels:ServicesPanel   x:Name="PanelSystem"   DataContext="{Binding}" Visibility="Collapsed"/>
                        <panels:NetworkPanel    x:Name="PanelInternet" DataContext="{Binding}" Visibility="Collapsed"/>
                        <panels:StartupPanel    x:Name="PanelStartup"  DataContext="{Binding}" Visibility="Collapsed"/>
                        <panels:BlacklistPanel  x:Name="PanelBlocked"  DataContext="{Binding}" Visibility="Collapsed"/>
                        <panels:SettingsPanel   x:Name="PanelSettings" Visibility="Collapsed"/>
                    </Grid>

                    <!-- ══ KILL LOG ══════════════════════════════════════ -->
                    <Border Grid.Row="3" Margin="12,0,12,12" CornerRadius="20" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource LogBg1}" Offset="0"/>
                                <GradientStop Color="{DynamicResource LogBg2}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💥 Kill Log" FontFamily="Segoe UI" FontWeight="SemiBold"
                                               FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Background="#303050" CornerRadius="8" Padding="5,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding KillCount}"
                                                   Foreground="#FF90D0" FontFamily="Segoe UI"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Click="ClearLog_Click" Cursor="Hand"
                                        BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock Text="clear ✨" Foreground="{DynamicResource TextSoft}"
                                               FontFamily="Segoe UI" FontSize="10"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                                          VerticalScrollBarVisibility="Auto" Padding="14,0,14,6">
                                <ItemsControl ItemsSource="{Binding KillLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                           Foreground="{DynamicResource TextSoft}"
                                                           FontFamily="Consolas" FontSize="10"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Tag}"
                                                           Foreground="{DynamicResource TextSoft}"
                                                           FontFamily="Consolas" FontSize="10"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           Foreground="#FF90D0" FontFamily="Segoe UI"
                                                           FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Result}"
                                                           Foreground="{DynamicResource TextSoft}"
                                                           FontFamily="Segoe UI" FontSize="10"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── RIGHT: anime girl panel ──────────────────────────── -->
                <Border x:Name="AnimeSidePanel" Grid.Column="1" Margin="0,12,12,12" CornerRadius="20" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource AnimePanelBg1}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AnimePanelBg2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <!-- Grid layout: GIF top, stats fill remaining space -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- GIF box -->
                            <RowDefinition Height="Auto"/>   <!-- label + tip -->
                            <RowDefinition Height="*"/>      <!-- live stats fill remaining -->
                        </Grid.RowDefinitions>

                        <!-- GIF frame — fixed 186×186, centred, top-padded -->
                        <Border Grid.Row="0" Width="186" Height="186" CornerRadius="16"
                                HorizontalAlignment="Center" ClipToBounds="True"
                                Margin="0,14,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AnimePanelBg2}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AnimePanelBg1}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="GifContainer" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                        </Border>

                        <!-- State label + tip — tightly below GIF -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock x:Name="AnimeLabel" Text="( ˘ᵕ˙ ) chilling~"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Border Margin="10,0" CornerRadius="12" Padding="10,7">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource AnimePanelBg2}" Opacity="0.5"/>
                                </Border.Background>
                                <TextBlock x:Name="AnimeTip" Text="Click 🔨 to smash!"
                                           FontFamily="Segoe UI" FontSize="10"
                                           Foreground="{DynamicResource TextSecond}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Live stats — fill the leftover space below GIF -->
                        <Border Grid.Row="2" Margin="10,10,10,12" CornerRadius="14" Padding="12,10">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AnimePanelBg2}" Opacity="0.6"/>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center">

                                <!-- Admin status badge -->
                                <Border x:Name="AdminBadge" CornerRadius="10" Padding="10,5"
                                        HorizontalAlignment="Center" Margin="0,0,0,8"
                                        Background="#20FF8020">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Not Admin" FontFamily="Segoe UI"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#FF8020" VerticalAlignment="Center"/>
                                        <Button x:Name="RunAsAdminBtn" Content=" → Fix"
                                                Margin="6,0,0,0" Cursor="Hand"
                                                BorderThickness="0" Background="Transparent"
                                                Click="RunAsAdmin_Click" Padding="0"
                                                FontFamily="Segoe UI" FontSize="10"
                                                FontWeight="SemiBold" Foreground="#FF8020"/>
                                    </StackPanel>
                                </Border>

                                <!-- VPN status -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🔴"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VpnActive}" Value="True">
                                                        <Setter Property="Text" Value="🟢"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding VpnLabel}" FontFamily="Segoe UI"
                                               FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C03050"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VpnActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#30A050"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource SoftBtnBg}" Margin="0,0,0,8"/>

                                <!-- Network totals -->
                                <StackPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="↓ " Foreground="#80B8F0" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalDown}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="↑ " Foreground="#F080A8" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalUp}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource SoftBtnBg}" Margin="0,0,0,8"/>

                                <!-- Kill count + processes -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,0,0,4">
                                    <TextBlock Text="💥 " FontSize="12"/>
                                    <TextBlock Text="{Binding KillCount}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="killed" Foreground="{DynamicResource TextSoft}"
                                               FontFamily="Segoe UI" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🖥️ " FontSize="12"/>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{DynamicResource TextSecond}"
                                               FontFamily="Segoe UI" FontSize="10"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
