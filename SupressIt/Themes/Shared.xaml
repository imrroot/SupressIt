<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SupressIt.Converters">

  <conv:EqualityConverter x:Key="EqConv"/>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>

  <!-- ── Colour resources (all mutable SolidColorBrush — NOT frozen) ──────── -->
  <SolidColorBrush x:Key="BgShell"          Color="#140E22"/>
  <SolidColorBrush x:Key="BgCard"           Color="#221838"/>
  <SolidColorBrush x:Key="BgTabBar"         Color="#181028"/>
  <SolidColorBrush x:Key="TextPrimary"      Color="#E8D8FF"/>
  <SolidColorBrush x:Key="TextSecond"       Color="#A088C8"/>
  <SolidColorBrush x:Key="TextSoft"         Color="#605080"/>
  <SolidColorBrush x:Key="AccentBrush"      Color="#8050C0"/>
  <SolidColorBrush x:Key="AccentBrush2"     Color="#C050A0"/>
  <SolidColorBrush x:Key="SoftBtnBg"        Color="#288050C0"/>
  <SolidColorBrush x:Key="SoftBtnFg"        Color="#8050C0"/>
  <SolidColorBrush x:Key="KillBtnBg"        Color="#30FF4060"/>
  <SolidColorBrush x:Key="KillBtnHover"     Color="#55FF4060"/>
  <SolidColorBrush x:Key="AccentTabChecked" Color="#308050C0"/>
  <SolidColorBrush x:Key="AccentTabHover"   Color="#188050C0"/>
  <SolidColorBrush x:Key="LogTextBrush"     Color="#FF90D0"/>
  <SolidColorBrush x:Key="LogTagBrush"      Color="#605080"/>
  <SolidColorBrush x:Key="AnimePanelBg"     Color="#201436"/>

  <!-- Color keys for gradient stops -->
  <Color x:Key="LogBg1"        >#180A2A</Color>
  <Color x:Key="LogBg2"        >#10061E</Color>
  <Color x:Key="AnimePanelBg1" >#201436</Color>
  <Color x:Key="AnimePanelBg2" >#180E2C</Color>

  <!-- ── Thin scrollbar ──────────────────────────────────────────────────── -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width"   Value="4"/>
    <Setter Property="Opacity" Value="0.35"/>
  </Style>

  <!-- ── Card ────────────────────────────────────────────────────────────── -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background"   Value="{DynamicResource BgCard}"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Margin"       Value="12,4"/>
    <Setter Property="Padding"      Value="12,10"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#60000000" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="#60000000" BlurRadius="18" ShadowDepth="3" Opacity="0.22"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ── CIRCULAR CHECKBOX ────────────────────────────────────────────────── -->
  <Style x:Key="CircleCheck" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="36" Height="20">
            <!-- Track -->
            <Border x:Name="Track" CornerRadius="10" Width="36" Height="20"
                    Background="{DynamicResource SoftBtnBg}"/>
            <!-- Thumb circle -->
            <Ellipse x:Name="Thumb" Width="14" Height="14"
                     Fill="{DynamicResource TextSoft}"
                     HorizontalAlignment="Left" Margin="3,0,0,0"
                     VerticalAlignment="Center">
              <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbTX" X="0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Thumb" Property="Fill"       Value="White"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTX"
                                     Storyboard.TargetProperty="X"
                                     To="16" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTX"
                                     Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default CheckBox = CircleCheck -->
  <Style TargetType="CheckBox" BasedOn="{StaticResource CircleCheck}"/>

  <!-- ── CIRCULAR SLIDER ──────────────────────────────────────────────────── -->
  <Style x:Key="CircleSlider" TargetType="Slider">
    <Setter Property="Minimum"          Value="0"/>
    <Setter Property="Maximum"          Value="1"/>
    <Setter Property="Height"           Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="20" VerticalAlignment="Center">
            <!-- Track background -->
            <Border Height="4" CornerRadius="2"
                    Background="{DynamicResource SoftBtnBg}"
                    VerticalAlignment="Center"/>
            <!-- Filled track -->
            <Border x:Name="FilledTrack" Height="4" CornerRadius="2"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>
            <!-- WPF requires the Track element for interaction -->
            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb Width="18" Height="18">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Circle" Width="18" Height="18"
                               Fill="{DynamicResource AccentBrush}"
                              >
                        <Ellipse.Effect>
                          <DropShadowEffect Color="#60000000" BlurRadius="6"
                                            ShadowDepth="1" Opacity="0.5"/>
                        </Ellipse.Effect>
                      </Ellipse>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Circle" Property="Width"  Value="20"/>
                          <Setter TargetName="Circle" Property="Height" Value="20"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentBrush2}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default Slider = CircleSlider -->
  <Style TargetType="Slider" BasedOn="{StaticResource CircleSlider}"/>

  <!-- ── Hammer / Kill button ─────────────────────────────────────────────── -->
  <Style x:Key="HammerBtnStyle" TargetType="Button">
    <Setter Property="Width"           Value="36"/>
    <Setter Property="Height"          Value="36"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="ToolTip"         Value="Kill! 🔨"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{DynamicResource KillBtnBg}"
                  CornerRadius="18" Width="36" Height="36"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform x:Name="Rot" Angle="0"/>
            </Border.RenderTransform>
            <TextBlock Text="🔨" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,2,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KillBtnHover}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rot"
                                     Storyboard.TargetProperty="Angle"
                                     To="-22" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rot"
                                     Storyboard.TargetProperty="Angle"
                                     To="0" Duration="0:0:0.12">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KillBtnHover}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rot"
                                     Storyboard.TargetProperty="Angle"
                                     To="28" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Block button ─────────────────────────────────────────────────────── -->
  <Style x:Key="BlockBtnStyle" TargetType="Button">
    <Setter Property="Width"           Value="36"/>
    <Setter Property="Height"          Value="36"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="ToolTip"         Value="Block forever! 🚫"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{DynamicResource SoftBtnBg}"
                  CornerRadius="18" Width="36" Height="36">
            <TextBlock Text="🚫" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTabChecked}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Soft action button ───────────────────────────────────────────────── -->
  <Style x:Key="SoftBtnStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="12,6"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="FontFamily"      Value="Segoe UI"/>
    <Setter Property="FontSize"        Value="11"/>
    <Setter Property="FontWeight"      Value="SemiBold"/>
    <Setter Property="Foreground"      Value="{DynamicResource SoftBtnFg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{DynamicResource SoftBtnBg}"
                  CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTabChecked}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Main tab toggle ──────────────────────────────────────────────────── -->
  <Style x:Key="TabBtnStyle" TargetType="ToggleButton">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="13,8"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="FontFamily"      Value="Segoe UI"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="FontWeight"      Value="SemiBold"/>
    <Setter Property="Foreground"      Value="{DynamicResource TextSoft}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="14"
                  Padding="{TemplateBinding Padding}">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTabChecked}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentTabHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Child tab (settings sub-tabs) ───────────────────────────────────── -->
  <Style x:Key="ChildTabStyle" TargetType="ToggleButton"
         BasedOn="{StaticResource TabBtnStyle}">
    <Setter Property="Padding"  Value="10,6"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

</ResourceDictionary>
