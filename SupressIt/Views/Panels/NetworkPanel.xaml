<UserControl x:Class="SupressIt.Views.Panels.NetworkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SupressIt.Converters"
             xmlns:models="clr-namespace:SupressIt.Models">
    <UserControl.Resources>
        <conv:BytesConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Global bandwidth summary + global limit -->
            <Border Margin="12,8,12,4" CornerRadius="16" Padding="16,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#15EAF2FF" Offset="0"/>
                        <GradientStop Color="#15FFE8F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Total Internet Right Now" FontFamily="Segoe UI"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="↓ " Foreground="#80B8F0" FontSize="12"/>
                                <TextBlock Text="{Binding TotalDown}" Foreground="#4070A8"
                                           FontSize="12" FontFamily="Segoe UI" Margin="0,0,14,0"/>
                                <TextBlock Text="↑ " Foreground="#F080A8" FontSize="12"/>
                                <TextBlock Text="{Binding TotalUp}" Foreground="#A04070"
                                           FontSize="12" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Global per-app limit -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding GlobalNetLimitEnabled}"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Global limit per app"
                                       Foreground="{DynamicResource TextSecond}"
                                       FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding GlobalNetLimitEnabled, Converter={StaticResource BoolVis}}">
                            <TextBox Text="{Binding GlobalNetLimitMb, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"
                                     Width="50" Background="{DynamicResource SoftBtnBg}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0" FontFamily="Segoe UI" FontSize="11"
                                     TextAlignment="Center" Padding="4,2" Margin="0,4,0,0"/>
                            <TextBlock Text=" MB → auto-block"
                                       Foreground="{DynamicResource TextSoft}"
                                       FontFamily="Segoe UI" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Per-process rows -->
            <ItemsControl ItemsSource="{Binding Network}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NetworkEntry}">
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource SoftBtnBg}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="17"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Pid, StringFormat='PID {0}'}"
                                                   Foreground="{DynamicResource TextSoft}" FontSize="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="↓ " Foreground="#80B8F0" FontSize="11"/>
                                            <TextBlock Text="{Binding DownSpeed, Converter={StaticResource BytesConverter}}"
                                                       Foreground="#4070A8" FontSize="11" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="↑ " Foreground="#F080A8" FontSize="11"/>
                                            <TextBlock Text="{Binding UpSpeed, Converter={StaticResource BytesConverter}}"
                                                       Foreground="#A04070" FontSize="11" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="total " Foreground="{DynamicResource TextSoft}" FontSize="10"/>
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="3" Style="{DynamicResource BlockBtnStyle}"
                                            Tag="{Binding Name}" Click="Block_Click" VerticalAlignment="Center"/>

                                    <CheckBox Grid.Column="4" IsChecked="{Binding LimitEnabled}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ToolTip="Enable per-app data limit"/>
                                </Grid>

                                <!-- Limit row -->
                                <Border Visibility="{Binding LimitEnabled, Converter={StaticResource BoolVis}}"
                                        Background="{DynamicResource SoftBtnBg}"
                                        CornerRadius="10" Padding="10,6" Margin="42,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚦 Block after "
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding LimitMb, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50" Background="Transparent"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 BorderThickness="0" FontFamily="Segoe UI" FontSize="11"
                                                 TextAlignment="Center" Padding="4,2"/>
                                        <TextBlock Text=" MB — used: "
                                                   Foreground="{DynamicResource TextSoft}"
                                                   FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontFamily="Segoe UI" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
