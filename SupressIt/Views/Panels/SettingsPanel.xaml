<UserControl x:Class="SupressIt.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sub="clr-namespace:SupressIt.Views.Panels.Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8">

            <!-- Child tab bar -->
            <Border Background="{DynamicResource SoftBtnBg}" CornerRadius="14" Padding="6" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="BtnTheme"   Content="🎨 Theme"   IsChecked="True"
                                  Style="{DynamicResource ChildTabStyle}" Click="Child_Click" Tag="Theme"/>
                    <ToggleButton x:Name="BtnGif"     Content="✨ GIF"
                                  Style="{DynamicResource ChildTabStyle}" Click="Child_Click" Tag="Gif"/>
                    <ToggleButton x:Name="BtnSound"   Content="🔊 Sound"
                                  Style="{DynamicResource ChildTabStyle}" Click="Child_Click" Tag="Sound"/>
                </StackPanel>
            </Border>

            <ContentPresenter x:Name="ChildContent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
