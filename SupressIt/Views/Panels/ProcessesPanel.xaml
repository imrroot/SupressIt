<UserControl x:Class="SupressIt.Views.Panels.ProcessesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SupressIt.Converters"
             xmlns:models="clr-namespace:SupressIt.Models">
    <UserControl.Resources>
        <conv:BytesConverter      x:Key="BytesConverter"/>
        <conv:PathToIconConverter x:Key="IconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Processes}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ProcessEntry}">
                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="38" Height="38"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10"
                                        ClipToBounds="True" Background="{DynamicResource SoftBtnBg}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Path, Converter={StaticResource IconConverter}}"
                                           Width="26" Height="26"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="15" Height="15" CornerRadius="7.5"
                                        Background="#D95030" BorderBrush="#FFFFE6" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        ToolTip="{Binding CriticalWarning}"
                                        Visibility="{Binding HasCriticalWarning, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold"
                                               FontFamily="Segoe UI" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding Pid, StringFormat='PID {0}'}"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="10" FontFamily="Segoe UI" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat='CPU {0:F1}%'}"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="10" FontFamily="Segoe UI" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding MemoryMb, StringFormat='MEM {0:F0}MB'}"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="10" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        Margin="0,0,10,0" MinWidth="80">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↓ " Foreground="#80B8F0" FontSize="11"/>
                                    <TextBlock Text="{Binding DownloadSpeed, Converter={StaticResource BytesConverter}}"
                                               Foreground="#5080B0" FontSize="11" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑ " Foreground="#F080A8" FontSize="11"/>
                                    <TextBlock Text="{Binding UploadSpeed, Converter={StaticResource BytesConverter}}"
                                               Foreground="#B05070" FontSize="11" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="3" Style="{DynamicResource HammerBtnStyle}"
                                    Tag="{Binding Pid}" Click="Kill_Click" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Style="{DynamicResource BlockBtnStyle}"
                                    Tag="{Binding Pid}" Click="Block_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
