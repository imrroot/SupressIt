<UserControl x:Class="SupressIt.Views.Panels.Settings.SoundSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SupressIt.Converters">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Enable Sounds" FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Supports .mp3 .wav .ogg .m4a .aac .flac .wma"
                               FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Volume:" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="60"/>
                    <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="1.0"
                            Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:P0}}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Segoe UI" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed:" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="60"/>
                    <Slider Value="{Binding SoundSpeed}" Minimum="0.5" Maximum="2.0"
                            Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SoundSpeed, StringFormat={}{0:F1}x}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Segoe UI" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Sound Files" FontFamily="Segoe UI" FontWeight="SemiBold"
                           FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Use manual files or read idle, search, kill and block from the app Sound folder"
                           FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Use app Sound folder" FontFamily="Segoe UI" FontWeight="SemiBold"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                        <TextBlock Text="{Binding DefaultSoundFolderPath}" TextTrimming="CharacterEllipsis"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding UseDefaultSoundFolder}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Normal" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplaySoundNormalPath}"
                               FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                            Tag="normal" Click="Browse_Click" Padding="8,4"
                            IsEnabled="{Binding UseDefaultSoundFolder, Converter={StaticResource InvBool}}"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplaySoundSearchingPath}"
                               FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                            Tag="searching" Click="Browse_Click" Padding="8,4"
                            IsEnabled="{Binding UseDefaultSoundFolder, Converter={StaticResource InvBool}}"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kill" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplaySoundKillPath}"
                               FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                            Tag="kill" Click="Browse_Click" Padding="8,4"
                            IsEnabled="{Binding UseDefaultSoundFolder, Converter={StaticResource InvBool}}"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Block" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplaySoundBlockPath}"
                               FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                            Tag="block" Click="Browse_Click" Padding="8,4"
                            IsEnabled="{Binding UseDefaultSoundFolder, Converter={StaticResource InvBool}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
