<UserControl x:Class="SupressIt.Views.Panels.Settings.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SupressIt.Views.Panels.Settings">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Inline color swatch button template -->
        <ControlTemplate x:Key="SwatchTpl" TargetType="Button">
            <Border x:Name="B" CornerRadius="18" Width="34" Height="34"
                    Background="{TemplateBinding Background}"
                    Margin="3">
                <Border.Effect>
                    <DropShadowEffect Color="#80000000" BlurRadius="6" ShadowDepth="0" Opacity="0"/>
                </Border.Effect>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A0000000" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ── Dark / Light toggle ─────────────────────────────────────── -->
        <Border Style="{DynamicResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Dark Mode" FontFamily="Segoe UI" FontWeight="SemiBold"
                         FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Switches shell, card and tab bar colours"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- ── Accent palette presets ──────────────────────────────────── -->
        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Accent Presets" FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Template="{StaticResource SwatchTpl}" Background="#8050C0"
                      Tag="Purple" Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Purple"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#3070FF"
                      Tag="Blue"   Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Blue"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#FF5090"
                      Tag="Pink"   Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Pink"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#20C080"
                      Tag="Mint"   Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Mint"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#FF8020"
                      Tag="Orange" Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Orange"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#E03030"
                      Tag="Red"    Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Red"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#00FFB0"
                      Tag="Cyber"  Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Cyber"/>
              <Button Template="{StaticResource SwatchTpl}" Background="#FF80A0"
                      Tag="Sakura" Click="Preset_Click" Cursor="Hand" BorderThickness="0" ToolTip="Sakura"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ── Per-zone colour pickers ─────────────────────────────────── -->
        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Per-Zone Colors  (hex)" FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

            <local:ColorRow Label="Accent"         Hex="{Binding ColorAccent,       Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Accent 2"        Hex="{Binding ColorAccent2,      Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Shell BG"        Hex="{Binding ColorShellBg,      Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Card BG"         Hex="{Binding ColorCardBg,       Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Tab Bar BG"      Hex="{Binding ColorTabBarBg,     Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Text Primary"    Hex="{Binding ColorTextPrimary,  Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Text Secondary"  Hex="{Binding ColorTextSecond,   Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Text Soft"       Hex="{Binding ColorTextSoft,     Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Kill Button"     Hex="{Binding ColorKillBtn,      Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Block Button"    Hex="{Binding ColorBlockBtn,     Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Log Background"  Hex="{Binding ColorLogBg,        Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Log Text"        Hex="{Binding ColorLogText,      Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Log Tag"         Hex="{Binding ColorLogTag,       Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Anime Panel BG"  Hex="{Binding ColorAnimePanelBg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Tab Checked"     Hex="{Binding ColorTabChecked,   Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <local:ColorRow Label="Tab Hover"       Hex="{Binding ColorTabHover,     Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
          </StackPanel>
        </Border>

        <!-- ── Background image ────────────────────────────────────────── -->
        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Custom Background" FontFamily="Segoe UI" FontWeight="SemiBold"
                           FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Image / GIF / WebM — centered"
                           FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" IsChecked="{Binding UseCustomBackground}" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="📁 Browse" Click="BrowseBg_Click"
                      Style="{DynamicResource SoftBtnStyle}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding BackgroundPath}" MaxWidth="200"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSoft}"
                         FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Image opacity -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="Image opacity:" Foreground="{DynamicResource TextSecond}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="110"/>
              <Slider Value="{Binding BackgroundOpacity}" Minimum="0.05" Maximum="1.0"
                      Width="130" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Elements opacity (so background shows through cards) -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Elements opacity:" Foreground="{DynamicResource TextSecond}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="110"/>
              <Slider Value="{Binding ElementsOpacity}" Minimum="0.2" Maximum="1.0"
                      Width="130" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding ElementsOpacity, StringFormat={}{0:P0}}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ── Icon animations ─────────────────────────────────────────── -->
        <Border Style="{DynamicResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Card &amp; Icon Animations" FontFamily="Segoe UI" FontWeight="SemiBold"
                         FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Disable for pure performance mode"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" IsChecked="{Binding IconAnimationsEnabled}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- Fix 4: Run at Windows Startup -->
        <Border Style="{DynamicResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Run at Windows Startup" FontFamily="Segoe UI" FontWeight="SemiBold"
                         FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="SupressIt starts with Windows and immediately begins killing blacklisted apps"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Grid.Column="1" IsChecked="{Binding RunAtStartup}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
</UserControl>
