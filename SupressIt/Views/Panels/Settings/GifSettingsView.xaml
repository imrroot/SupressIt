<UserControl x:Class="SupressIt.Views.Panels.Settings.GifSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SupressIt.Converters">
    <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqConv"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Style="{DynamicResource CardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Enable Anime GIFs" FontFamily="Segoe UI" FontWeight="SemiBold"
                         FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Disable for pure performance mode"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" IsChecked="{Binding GifsEnabled}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Kill Animation Style" FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Content="Fly" GroupName="KA" Margin="0,0,14,0"
                           IsChecked="{Binding KillAnimationType, Converter={StaticResource EqConv}, ConverterParameter=Fly}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
              <RadioButton Content="Spin" GroupName="KA" Margin="0,0,14,0"
                           IsChecked="{Binding KillAnimationType, Converter={StaticResource EqConv}, ConverterParameter=Spin}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
              <RadioButton Content="Bounce" GroupName="KA"
                           IsChecked="{Binding KillAnimationType, Converter={StaticResource EqConv}, ConverterParameter=Bounce}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Speed:" Foreground="{DynamicResource TextSecond}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="60"/>
              <Slider Value="{Binding KillAnimationSpeed}" Minimum="0.2" Maximum="3.0" Width="150"/>
              <TextBlock Text="{Binding KillAnimationSpeed, StringFormat={}{0:F1}x}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Item Death Animation" FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Text="How a row disappears after being killed"
                       FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Content="Burn" GroupName="DA" Margin="0,0,14,0"
                           IsChecked="{Binding ItemDeathAnimation, Converter={StaticResource EqConv}, ConverterParameter=Burn}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
              <RadioButton Content="Fade" GroupName="DA" Margin="0,0,14,0"
                           IsChecked="{Binding ItemDeathAnimation, Converter={StaticResource EqConv}, ConverterParameter=Fade}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
              <RadioButton Content="Shrink" GroupName="DA" Margin="0,0,14,0"
                           IsChecked="{Binding ItemDeathAnimation, Converter={StaticResource EqConv}, ConverterParameter=Shrink}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
              <RadioButton Content="None" GroupName="DA"
                           IsChecked="{Binding ItemDeathAnimation, Converter={StaticResource EqConv}, ConverterParameter=None}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecond}" Cursor="Hand"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Duration:" Foreground="{DynamicResource TextSecond}"
                         FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Width="60"/>
              <Slider Value="{Binding ItemDeathDuration}" Minimum="0.1" Maximum="2.0" Width="150"/>
              <TextBlock Text="{Binding ItemDeathDuration, StringFormat={}{0:F1}s}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
          <StackPanel>
            <TextBlock Text="GIF / Video Files" FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text=".gif, .webm, .mp4 and .avi supported - speed multiplier per state"
                       FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Use app GIF folder" FontFamily="Segoe UI" FontWeight="SemiBold"
                           FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                <TextBlock Text="{Binding DefaultGifFolderPath}" TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" IsChecked="{Binding UseDefaultGifFolder}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Normal" FontFamily="Segoe UI" FontSize="11"
                         Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding DisplayGifNormalPath}" TextTrimming="CharacterEllipsis"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                         VerticalAlignment="Center" Margin="4,0"/>
              <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                      Tag="normal" Click="Browse_Click" Padding="5,4"
                      IsEnabled="{Binding UseDefaultGifFolder, Converter={StaticResource InvBool}}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Slider Value="{Binding GifNormalSpeed}" Minimum="0.2" Maximum="3.0" Width="52"/>
                <TextBlock Text="{Binding GifNormalSpeed, StringFormat={}{0:F1}x}"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI"
                           FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Search" FontFamily="Segoe UI" FontSize="11"
                         Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding DisplayGifSearchingPath}" TextTrimming="CharacterEllipsis"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                         VerticalAlignment="Center" Margin="4,0"/>
              <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                      Tag="searching" Click="Browse_Click" Padding="5,4"
                      IsEnabled="{Binding UseDefaultGifFolder, Converter={StaticResource InvBool}}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Slider Value="{Binding GifSearchingSpeed}" Minimum="0.2" Maximum="3.0" Width="52"/>
                <TextBlock Text="{Binding GifSearchingSpeed, StringFormat={}{0:F1}x}"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI"
                           FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Kill" FontFamily="Segoe UI" FontSize="11"
                         Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding DisplayGifKillPath}" TextTrimming="CharacterEllipsis"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                         VerticalAlignment="Center" Margin="4,0"/>
              <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                      Tag="kill" Click="Browse_Click" Padding="5,4"
                      IsEnabled="{Binding UseDefaultGifFolder, Converter={StaticResource InvBool}}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Slider Value="{Binding GifKillSpeed}" Minimum="0.2" Maximum="3.0" Width="52"/>
                <TextBlock Text="{Binding GifKillSpeed, StringFormat={}{0:F1}x}"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI"
                           FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Block" FontFamily="Segoe UI" FontSize="11"
                         Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding DisplayGifBlockPath}" TextTrimming="CharacterEllipsis"
                         FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource TextSoft}"
                         VerticalAlignment="Center" Margin="4,0"/>
              <Button Grid.Column="2" Content="..." ToolTip="Browse" Style="{DynamicResource SoftBtnStyle}"
                      Tag="block" Click="Browse_Click" Padding="5,4"
                      IsEnabled="{Binding UseDefaultGifFolder, Converter={StaticResource InvBool}}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Slider Value="{Binding GifBlockSpeed}" Minimum="0.2" Maximum="3.0" Width="52"/>
                <TextBlock Text="{Binding GifBlockSpeed, StringFormat={}{0:F1}x}"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI"
                           FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
</UserControl>
