<UserControl x:Class="SupressIt.Views.Panels.Settings.ColorRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Height="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Label -->
        <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{DynamicResource TextSecond}"
                   VerticalAlignment="Center"/>

        <!-- Live colour swatch -->
        <Ellipse Grid.Column="1" Width="16" Height="16"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 x:Name="Swatch"/>

        <!-- Hex input -->
        <Border Grid.Column="2" Background="{DynamicResource SoftBtnBg}"
                CornerRadius="8" Padding="8,3" Margin="4,0,0,0">
            <TextBox x:Name="HexBox"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11"
                     Foreground="{DynamicResource AccentBrush}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center"
                     Text="{Binding Hex, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="HexBox_TextChanged"/>
        </Border>
    </Grid>
</UserControl>
