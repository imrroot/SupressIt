<UserControl x:Class="SupressIt.Views.Panels.StartupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SupressIt.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="12,8,12,4" CornerRadius="14" Padding="14,10" Background="#12FFFAE8">
                <TextBlock FontFamily="Segoe UI" FontSize="12"
                           Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap">
                    💡 These apps start automatically when you turn on your PC.
                    Disabling them makes Windows start faster — they still work, you just open them yourself!
                </TextBlock>
            </Border>
            <ItemsControl ItemsSource="{Binding Startup}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StartupEntry}">
                        <Border Style="{DynamicResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SoftBtnBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#2040C060"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="😴"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="🚀"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding Location}"
                                                   Foreground="{DynamicResource TextSoft}"
                                                   FontSize="10" FontFamily="Segoe UI" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                   FontFamily="Segoe UI" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#C08040"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="#40A060"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{Binding ToggleLabel}"
                                        Tag="{Binding}" Style="{DynamicResource SoftBtnStyle}"
                                        Click="Toggle_Click" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsToggleSupported}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
