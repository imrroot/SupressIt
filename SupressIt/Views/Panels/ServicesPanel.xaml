<UserControl x:Class="SupressIt.Views.Panels.ServicesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SupressIt.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Services}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ServiceEntry}">
                    <Border Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="38" Height="38"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SoftBtnBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Background" Value="#2040C060"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="S"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Text" Value="R"/>
                                                        <Setter Property="Foreground" Value="#40A060"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border Width="15" Height="15" CornerRadius="7.5"
                                        Background="#D95030" BorderBrush="#FFFFE6" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        ToolTip="{Binding CriticalWarning}"
                                        Visibility="{Binding HasCriticalWarning, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold"
                                               FontFamily="Segoe UI" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding ServiceName}"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="10" FontFamily="Segoe UI" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10"
                                               FontFamily="Segoe UI" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#C08040"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="#40A060"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                    Tag="{Binding ServiceName}"
                                    Style="{DynamicResource SoftBtnStyle}"
                                    Click="Toggle_Click"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Style="{DynamicResource BlockBtnStyle}"
                                    Tag="{Binding ServiceName}"
                                    Click="Block_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
